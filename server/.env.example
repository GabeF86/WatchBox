# Copy to server/.env and fill in.
# Most accurate: eBay sold (90 days) + Chrono24 asking prices via Apify (https://apify.com → Settings → API & Integrations).
APIFY_TOKEN=
# Price source: TheWatchAPI (free token at https://www.thewatchapi.com/register).
THEWATCHAPI_TOKEN=
# Optional fallback: eBay Browse API (Production keyset from https://developer.ebay.com).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# auto = Apify valuation engine if APIFY_TOKEN is set, else TheWatchAPI, else eBay. Or force: comps | thewatchapi | ebay
PRICE_SOURCE=auto
# TheWatchAPI's free plan allows 25 requests/day: one refresh a day for 8 watches uses 8.
REFRESH_HOURS=24
PORT=8000
DB_PATH=watchbox.db
